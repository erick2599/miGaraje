# Copiá este archivo como .env.local (desarrollo) o cargá las mismas
# variables en Vercel (Project Settings → Environment Variables).
#
# Están en Supabase: Project Settings → API.
# La anon key es pública y puede viajar al navegador: RLS protege los datos.
# NUNCA pongas la service_role key en el frontend.

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica
